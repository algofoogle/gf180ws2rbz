	(text "Initially mostly just have footprints for parts we want to solder/test:\n* CH32X033\n* USB-C socket\n* ASIC interface: Mezzanine + headers + COB\n* MS7210\n* MS9288C + crystal\n* 4 level shifters\n* 3 LDOs (1.2V, 1.8V, 3.3V)\n* QSPI + header\n* HDMI\n* VGA socket"
		(exclude_from_sim no)
		(at 14.986 32.258 0)
		(effects
			(font
				(size 1.905 1.905)
			)
			(justify left)
		)
		(uuid "f8022c4a-1166-4ce2-b8a9-dab6cd7e08c4")
	)
	(text "NOTE:\nMight be OK to\nshort R17 and\nmake pulldowns\nDNP if MS9288C\nsupports 5V\nfrom HDMI"
		(exclude_from_sim no)
		(at 67.564 160.782 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right)
		)
		(uuid "ffadc4c8-4f04-4cd7-9f73-55ed33f77e95")
	)
